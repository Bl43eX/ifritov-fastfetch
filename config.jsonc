{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small", // Change to "auto" for default logo
    "padding": { "top": 2, "right": 4 }
  },
  "display": {
    "separator": " ▸ "
  },
  "modules": [
    { "type": "title" },
    "break",
    { "type": "custom", "format": "\u001b[90m┌────────────────────────────────────────────────────────────┐" },
    { "type": "host",   "key": " ",  "keyColor": "blue" },
    { "type": "os",     "key": "🐧", "format": "{3} | {kernel-release}" },
    { "type": "de", 
      "key": " ",  
      "keyColor": "green"
    },
    { "type": "wm", 
      "key": " ",
      "keyColor": "green"
    },
    { "type": "custom", "format": "\u001b[90m├─────────────────────────────────────────────────────────────┤" },
    { "type": "cpu",    "key": " ",  "keyColor": "blue", "format": "{1} ({4}) @ {7}" },
    { "type": "gpu",    "key": "󰢮 ",  "keyColor": "magenta", "format": "{2} [Integrated]", "hideType": "discrete" },
    { "type": "gpu",    "key": "󰢮 ",  "keyColor": "magenta", "format": "{2} [Discrete]",   "hideType": "integrated" },
    { "type": "memory", "key": " ",  "keyColor": "cyan" },
    { "type": "swap",   "key": "󰓡 ",  "keyColor": "cyan" },
    { "type": "disk",   "key": "󰋊 ",  "keyColor": "red" },
    { "type": "custom", "format": "\u001b[90m├─────────────────────────────────────────────────────────────┤" },
    { "type": "battery","key": " ",  "keyColor": "yellow" },
    { "type": "uptime", "key": "󱎫 ",  "keyColor": "green" },
    { "type": "custom", "format": "\u001b[90m└────────────────────────────────────────────────────────────┘" },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 22
    }
  ]
}
